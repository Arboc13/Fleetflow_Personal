# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://fleetflow:fleetflow@localhost:5432/fleetflow
SECRET_KEY=replace-with-a-long-random-string-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
